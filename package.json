{
  "name": "taberoa-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm -s posters && node scripts/run.ts dev",
    "build": "pnpm -s posters && next build",
    "start": "node scripts/run.ts start",
    "check": "pnpm check:biome && pnpm typecheck && pnpm test && pnpm check:boundaries && pnpm knip && pnpm check:spec && node scripts/agent-hooks.ts certify",
    "check:biome": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts' 'scripts/**/*.test.ts'",
    "check:boundaries": "node scripts/checks/boundaries.ts",
    "knip": "knip",
    "check:spec": "pnpm dlx @fission-ai/openspec@1.13.2 validate --all --strict",
    "parity": "node scripts/checks/parity.ts",
    "delivery:branch": "node scripts/delivery.ts branch",
    "delivery:pr-check": "node scripts/delivery.ts pr-check",
    "delivery:pr-create": "node scripts/delivery.ts pr-create",
    "delivery:merge": "node scripts/delivery.ts merge",
    "perf": "node scripts/checks/perf.ts",
    "posters": "tsx --tsconfig scripts/tsconfig.json scripts/posters.tsx"
  },
  "dependencies": {
    "lucide-react": "0.556.0",
    "next": "15.5.27",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/node": "22.19.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.22",
    "knip": "6.41.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.29",
      "nanoid@<3.3.18": "3.3.20",
      "source-map-js@<1.2.2": "1.2.2",
      "sharp@<0.35.5": "0.35.5"
    }
  }
}
